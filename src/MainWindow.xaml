<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="RootSurface" Background="#59101010" TextElement.Foreground="#F0F0F0" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
  <Grid.Resources>
    <LinearGradientBrush x:Key="EmptyStageBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#355F5F5F" Offset="0" />
      <GradientStop Color="#261D1D1D" Offset="0.5" />
      <GradientStop Color="#30414141" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Muted" Color="#9A9A9A" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E7E7E7" /><Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="14,9" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <Grid><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /><Border x:Name="HoverGlow" Background="White" Opacity="0" CornerRadius="7" IsHitTestVisible="False" /></Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverGlow" Property="Opacity" Value="0.08" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3DFFFFFF" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverGlow" Property="Opacity" Value="0.14" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8B8B8" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#B8B8B8" /><Setter Property="Foreground" Value="#202020" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="6,4" /><Setter Property="MinWidth" Value="30" /><Setter Property="Height" Value="32" />
    </Style>
    <Style TargetType="Slider"><Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,8" /><Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="#CFCFCF" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#33B8B8B8" /><Setter Property="Foreground" Value="#ECECEC" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B8B8B8" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
            <DataTemplate x:Key="PlaylistRowTemplate"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="98" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="88" Height="56" Background="#1FFFFFFF" CornerRadius="6" VerticalAlignment="Center" ClipToBounds="True"><Grid><TextBlock x:Name="KindLabel" Text="{Binding Kind}" FontSize="8" Foreground="#D3D3D3" VerticalAlignment="Center" HorizontalAlignment="Center" /><Image Source="{Binding Thumb.Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" /></Grid></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Path}" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding Thumb.HasImage}" Value="True"><Setter TargetName="KindLabel" Property="Visibility" Value="Collapsed" /></DataTrigger></DataTemplate.Triggers>
            </DataTemplate>
    <DataTemplate x:Key="PlaylistTileTemplate">
      <StackPanel ToolTip="{Binding Path}">
        <Border Height="82" Background="#1FFFFFFF" CornerRadius="6" ClipToBounds="True">
          <Grid>
            <TextBlock Text="{Binding Kind}" Foreground="#D3D3D3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="{Binding Thumb.Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,7,0,0" FontSize="11"/>
        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid x:Name="BodyGrid" Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="240" MaxWidth="520" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="360" /></Grid.ColumnDefinitions>
    <Border x:Name="PlaylistPanel" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0" Background="#3D181818" Padding="12,14,12,10" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="4,0,4,20"><TextBlock x:Name="SidebarTitle" Text="Playlist" TextTrimming="CharacterEllipsis" Margin="0,0,32,0" FontSize="13" FontWeight="SemiBold" Foreground="#ACACAC" /><TextBlock x:Name="CountLabel" Text="0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}" /></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="AddFilesButton" Content="Open files" Padding="8,8" /><Button x:Name="FolderButton" Grid.Column="2" Content="Open folder" Padding="9,9" /></Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <Grid>            <TextBox x:Name="PlaylistSearch" ToolTip="Search this playlist or folder" AutomationProperties.Name="Search playlist" Background="#18FFFFFF" Foreground="#F0F0F0" CaretBrush="#B8B8B8" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="7,5" FontSize="12"/>              <TextBlock Text="Search" Foreground="#9A9A9A" Margin="8,5" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PlaylistSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" Padding="3" Visibility="Collapsed" ToolTip="Clear search" AutomationProperties.Name="Clear search"/>
            <Button x:Name="SortButton" Grid.Column="2" Content="↕" Padding="3" Background="Transparent" ToolTip="Sort" AutomationProperties.Name="Sort playlist"/>
          </Grid>
          <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel x:Name="Breadcrumbs" Orientation="Horizontal"/></ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="3">
          <ListBox x:Name="Playlist" ItemTemplate="{StaticResource PlaylistRowTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Media playlist">

          </ListBox>
          <StackPanel x:Name="PlaylistEmpty" VerticalAlignment="Center" Margin="15,0"><TextBlock x:Name="PlaylistEmptyLabel" Text="No files yet" Foreground="#797979" TextAlignment="Center" FontSize="12" /></StackPanel>
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="UpFolderButton" Content="↑" Width="32" Padding="4" ToolTip="Parent folder" IsEnabled="False" /><Button x:Name="FavoritesButton" Content="★" Width="32" Padding="4" Margin="4,0" ToolTip="Favorites" /><Button x:Name="PlaylistLayoutButton" Content="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Width="32" Padding="4" Margin="0,0,4,0" ToolTip="Two-column thumbnails" AutomationProperties.Name="Two-column thumbnails" /></StackPanel><Button Grid.Column="1" x:Name="ClearButton" Content="Clear" Background="Transparent" Foreground="#ACACAC" Padding="9,6" IsEnabled="False" /></Grid>
      </Grid>
    </Border>
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragIncrement="1" KeyboardIncrement="16" Focusable="True" Cursor="SizeWE" ToolTip="Drag to resize sidebar" AutomationProperties.Name="Resize sidebar">
      <GridSplitter.Style><Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter"><Grid Background="{TemplateBinding Background}"><Border x:Name="Handle" Width="2" Height="36" Background="#33FFFFFF" CornerRadius="1" VerticalAlignment="Center" HorizontalAlignment="Center" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#B8B8B8" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Handle" Property="Background" Value="#B8B8B8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style></GridSplitter.Style>
    </GridSplitter>
    <Grid Grid.Column="2" Margin="0,4,4,4">
      <Border x:Name="StageBorder" Background="{StaticResource EmptyStageBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid x:Name="Stage" Background="Transparent" AllowDrop="True" ClipToBounds="True">
          <Grid x:Name="VisualMedia" RenderTransformOrigin="0.5,0.5">
          <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" Visibility="Collapsed" />
          <Border x:Name="ScrubSurface" Background="Black" Visibility="Collapsed" IsHitTestVisible="False"><Image x:Name="ScrubImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Border>
          <Image x:Name="Photo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
          </Grid>
          <StackPanel x:Name="AudioPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="30">
            <Border Width="128" Height="128" CornerRadius="64" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock x:Name="AudioTitle" Text="" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
            <TextBlock x:Name="AudioDetail" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0" />
            <Grid x:Name="SpectrumBars" Height="92" Width="460" Margin="0,24,0,0" />
          </StackPanel>
          <Button x:Name="ZoomResetButton" Content="100%" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4" FontSize="11" Background="#B0252525" Visibility="Collapsed" ToolTip="Reset zoom to fit" AutomationProperties.Name="Reset zoom to fit"/>
          <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450" Margin="30">
            <Image x:Name="WelcomeLogo" Width="96" Height="96" Margin="0,0,0,20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Trill Media Player logo" />
            <TextBlock x:Name="WelcomeTitle" Text="Trill Media Player" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="WelcomeDescription" Text="Drop files here" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="23" TextAlignment="Center" TextWrapping="Wrap" Margin="0,13,0,23" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="WelcomeOpenButton" Content="Open files" Style="{StaticResource AccentButton}" Padding="23,11" /><Button x:Name="WelcomeFolderButton" Content="Open folder" Background="Transparent" Margin="8,0,0,0" Padding="16,11" /></StackPanel>
            <TextBlock x:Name="WelcomeHint" Text="" TextAlignment="Center" Foreground="#6F6F6F" FontSize="11" Margin="0,22,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  <Border x:Name="TransportBar" Grid.Row="1" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="8,5" Background="#40181818">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
        <Button x:Name="PreviousButton" Style="{StaticResource TransportButton}" ToolTip="Previous item" AutomationProperties.Name="Previous item"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE892;" FontSize="15" /></Button>
        <Button x:Name="BackButton" Content="−10s" Style="{StaticResource TransportButton}" FontSize="11" Margin="2,0" ToolTip="Back ten seconds" AutomationProperties.Name="Back ten seconds" />
        <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Width="36" Height="32" Padding="5" Margin="2,0" AutomationProperties.Name="Play or pause"><TextBlock x:Name="PlayGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="17" /></Button>
        <Button x:Name="ForwardButton" Content="+10s" Style="{StaticResource TransportButton}" FontSize="11" Margin="2,0" ToolTip="Forward ten seconds" AutomationProperties.Name="Forward ten seconds" />
        <Button x:Name="NextButton" Style="{StaticResource TransportButton}" ToolTip="Next item" AutomationProperties.Name="Next item"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE893;" FontSize="15" /></Button>
      </StackPanel>
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="PositionLabel" Text="" MinWidth="28" Margin="0,0,4,0" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False" AutomationProperties.Name="Playback position" ToolTip="Drag to preview · Move up into the magnified timeline for precision" />
        <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="" MinWidth="28" Margin="4,0,0,0" TextAlignment="Right" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
        <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" AutomationProperties.Name="Mute or unmute" ToolTip="Mute"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="15" x:Name="VolumeGlyph" /></Button>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Width="62" SmallChange="0.05" LargeChange="0.1" Margin="0,0,4,0" AutomationProperties.Name="Volume" />
        <TextBlock x:Name="VolumeLabel" Text="75%" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Width="28" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="LoopButton" Content="↻¹" Style="{StaticResource TransportButton}" ToolTip="Loop current media" AutomationProperties.Name="Loop mode" /><Button x:Name="ShuffleButton" Content="⤨" Style="{StaticResource TransportButton}" ToolTip="Shuffle" AutomationProperties.Name="Shuffle" /><Button x:Name="FavoriteButton" Content="☆" Style="{StaticResource TransportButton}" ToolTip="Favorite" AutomationProperties.Name="Favorite current media" /><Button x:Name="AbLoopButton" Content="A-B" Style="{StaticResource TransportButton}" ToolTip="Loop a section" AutomationProperties.Name="Loop a section" /><Button x:Name="ExportButton" Style="{StaticResource TransportButton}" ToolTip="Save current frame as a picture" AutomationProperties.Name="Save current frame"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="15" /></Button><Button x:Name="SpeedButton" Content="1×" Background="#1FFFFFFF" ToolTip="Playback speed" MinWidth="42" Height="32" Padding="6,4" Margin="0,0,4,0" AutomationProperties.Name="Playback speed" />
        <Button x:Name="SettingsButton" Style="{StaticResource TransportButton}" AutomationProperties.Name="Settings and keyboard shortcuts" ToolTip="Settings"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" /></Button>
        <Button x:Name="PlaylistButton" Style="{StaticResource TransportButton}" ToolTip="Toggle playlist" AutomationProperties.Name="Toggle playlist"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="16" /></Button>
        <Button x:Name="FocusButton" Content="&#xE18C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TransportButton}" ToolTip="Focus mode · Ctrl+Shift+F" AutomationProperties.Name="Focus mode"/>
        <Button x:Name="FullscreenButton" Style="{StaticResource TransportButton}" ToolTip="Fullscreen" AutomationProperties.Name="Toggle fullscreen"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="15" /></Button>
      </StackPanel>
    </Grid>
  </Border>
  <Border x:Name="StatusToast" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Background="#CF121212" CornerRadius="6" Padding="9,5" Visibility="Collapsed" IsHitTestVisible="False">
    <TextBlock x:Name="StatusLabel" Text="" Foreground="#BDBDBD" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
  </Border>
</Grid>