<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="TrillSliderTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border x:Name="Rail" Height="3" Background="{TemplateBinding Background}"
                    CornerRadius="1.5" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="Vertical">
              <Setter TargetName="Rail" Property="Height" Value="Auto"/>
              <Setter TargetName="Rail" Property="Width" Value="3"/>
              <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch"/>
              <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrillSliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="#B8B8B8"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{TemplateBinding Background}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="Width" Value="12"/>
              <Setter TargetName="Dot" Property="Height" Value="12"/>
              <Setter TargetName="Dot" Property="Fill" Value="#E3E3E3"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Dot" Property="Width" Value="12"/>
              <Setter TargetName="Dot" Property="Height" Value="12"/>
              <Setter TargetName="Dot" Property="Fill" Value="#EFEFEF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Dot" Property="Fill" Value="#5D5D5D"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrillSlider" TargetType="Slider">
    <Setter Property="Background" Value="#373737"/>
    <Setter Property="Foreground" Value="#B8B8B8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderRoot" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="FullRail" Height="3" Margin="8,0" CornerRadius="1.5"
                    Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
            <!-- A-B loop marks. Beneath the track on purpose: the repeat buttons paint
                 only a 3px rail, so the halo shows around it and the thumb stays on top. -->
            <Canvas x:Name="LoopMarks" Height="18" VerticalAlignment="Center"
                    IsHitTestVisible="False" Opacity="0" ClipToBounds="False">
              <Border x:Name="LoopBand" Height="11" Width="0" Canvas.Top="3.5" CornerRadius="5.5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0092E1C0" Offset="0"/>
                    <GradientStop Color="#E092E1C0" Offset="0.26"/>
                    <GradientStop Color="#6692E1C0" Offset="0.42"/>
                    <GradientStop Color="#6692E1C0" Offset="0.58"/>
                    <GradientStop Color="#E092E1C0" Offset="0.74"/>
                    <GradientStop Color="#0092E1C0" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect Color="#92E1C0" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
              </Border>
              <Border x:Name="LoopStartMark" Width="2" Height="16" Canvas.Top="1" CornerRadius="1" Background="#F2CFF6E4">
                <Border.Effect>
                  <DropShadowEffect Color="#92E1C0" BlurRadius="7" ShadowDepth="0" Opacity="0.85"/>
                </Border.Effect>
              </Border>
              <Border x:Name="LoopEndMark" Width="2" Height="16" Canvas.Top="1" CornerRadius="1" Background="#F2CFF6E4" Visibility="Collapsed">
                <Border.Effect>
                  <DropShadowEffect Color="#92E1C0" BlurRadius="7" ShadowDepth="0" Opacity="0.85"/>
                </Border.Effect>
              </Border>
            </Canvas>
            <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="DecreaseTrack" Command="{x:Static Slider.DecreaseLarge}"
                              Background="{TemplateBinding Foreground}" Style="{StaticResource TrillSliderTrackButton}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="SliderThumb" Style="{StaticResource TrillSliderThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="IncreaseTrack" Command="{x:Static Slider.IncreaseLarge}"
                              Background="{TemplateBinding Background}" Style="{StaticResource TrillSliderTrackButton}"/>
              </Track.IncreaseRepeatButton>
            </Track>
            <Border x:Name="FocusOutline" BorderBrush="#909090" BorderThickness="1" CornerRadius="5"
                    Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusOutline" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="DecreaseTrack" Property="Background" Value="#414141"/>
              <Setter TargetName="IncreaseTrack" Property="Background" Value="#2E2E2E"/>
              <Setter TargetName="FullRail" Property="Background" Value="#2E2E2E"/>
              <Setter TargetName="SliderRoot" Property="Opacity" Value="0.65"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter TargetName="PART_Track" Property="Height" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="Width" Value="18"/>
              <Setter TargetName="PART_Track" Property="VerticalAlignment" Value="Stretch"/>
              <Setter TargetName="PART_Track" Property="HorizontalAlignment" Value="Center"/>
              <Setter TargetName="SliderThumb" Property="Width" Value="18"/>
              <Setter TargetName="SliderThumb" Property="Height" Value="16"/>
              <Setter TargetName="FullRail" Property="Height" Value="Auto"/>
              <Setter TargetName="FullRail" Property="Width" Value="3"/>
              <Setter TargetName="FullRail" Property="Margin" Value="0,8"/>
              <Setter TargetName="FullRail" Property="VerticalAlignment" Value="Stretch"/>
              <Setter TargetName="FullRail" Property="HorizontalAlignment" Value="Center"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider" BasedOn="{StaticResource TrillSlider}"/>

  <Style x:Key="TrillScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrillScrollThumb" TargetType="Thumb">
    <Setter Property="MinWidth" Value="6"/>
    <Setter Property="MinHeight" Value="6"/>
    <Setter Property="Background" Value="#414141"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ScrollThumb" Background="{TemplateBinding Background}" CornerRadius="3"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#626262"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#8F8F8F"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="ScrollRoot" Width="6" HorizontalAlignment="Right" Background="{TemplateBinding Background}" Margin="1">
            <Track x:Name="PART_Track" IsDirectionReversed="True"
                   Orientation="{TemplateBinding Orientation}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreaseScroll" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource TrillScrollTrackButton}"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource TrillScrollThumb}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreaseScroll" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource TrillScrollTrackButton}"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="ScrollRoot" Property="Width" Value="Auto"/>
              <Setter TargetName="ScrollRoot" Property="Height" Value="6"/>
              <Setter TargetName="ScrollRoot" Property="HorizontalAlignment" Value="Stretch"/>
              <Setter TargetName="ScrollRoot" Property="VerticalAlignment" Value="Bottom"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              <Setter TargetName="DecreaseScroll" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
              <Setter TargetName="IncreaseScroll" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Width" Value="Auto"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
